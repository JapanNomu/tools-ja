# ============================================================
# Cognee 設定（基本変更不要）
# ============================================================

# Cognee のデータルート（Ladybug DB と LanceDB のファイルが置かれる場所）
COGNEE_DATA_PATH=./data/cognee

# LLM 設定
# デフォルトは動作実証済みの qwen2.5:14b（num_ctx=8192・RTX 4060 8GB で動作確認・全機能20/20成功）
# クラウドAPI（Claude / OpenAI）を強く推奨。詳細は docs/GETTING_STARTED.md「推奨LLM・推奨環境」参照
#
# 【Claude API を使う場合】
#   LLM_PROVIDER=anthropic
#   LLM_MODEL=claude-sonnet-4-6
#   LLM_ENDPOINT=https://api.anthropic.com
#   LLM_API_KEY=<your_anthropic_api_key>
#
# 【OpenAI API を使う場合】
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o
#   LLM_ENDPOINT=https://api.openai.com/v1
#   LLM_API_KEY=<your_openai_api_key>
#
# 【ローカル Ollama を使う場合（デフォルト）】
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
LLM_ENDPOINT=http://localhost:11434/v1
LLM_API_KEY=ollama

# 埋め込みモデル設定（FastEmbed を使う場合はそのまま）
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
HUGGINGFACE_TOKENIZER=sentence-transformers/all-MiniLM-L6-v2


# ============================================================
# データ永続化パス（必ず自環境の絶対パスに変更してください）
# ============================================================
#
# このシステムは Cognee がグラフDB（Ladybug DB）とベクトルDB（LanceDB）を
# ローカルディレクトリに保存します。その保存先を絶対パスで指定する設定です。
#
# 【設定方法】
#   1. ターミナルでこの配布物のフォルダに `cd` する
#   2. `pwd` を実行して現在のディレクトリの絶対パスを取得する
#   3. その絶対パスを以下に当てはめて書き換える
#
# 【例】配布物を `/home/yourname/cognee-system/` に置いた場合:
#   SYSTEM_ROOT_DIRECTORY=/home/yourname/cognee-system/data/cognee/system
#   DATA_ROOT_DIRECTORY=/home/yourname/cognee-system/data/cognee/data
#
# 【例】WSL2（Windows）で `/home/yourname/projects/cognee/` に置いた場合:
#   SYSTEM_ROOT_DIRECTORY=/home/yourname/projects/cognee/data/cognee/system
#   DATA_ROOT_DIRECTORY=/home/yourname/projects/cognee/data/cognee/data
#
# 【重要】
# - 相対パス（`./data/cognee/...` 等）は使えません
# - 必ず絶対パス（`/` から始まる）で指定してください
# - `data/cognee/system` `data/cognee/data` のフォルダは自動作成されます
#   （手動で作る必要はありません）
#
SYSTEM_ROOT_DIRECTORY=/your/absolute/path/to/project/data/cognee/system
DATA_ROOT_DIRECTORY=/your/absolute/path/to/project/data/cognee/data


# ============================================================
# FLUSHER 起動構成 (FR08-CFG・任意設定)
# ============================================================
#
# cognee_remember_flusher.py が MCP サーバを spawn する際に使う Python とスクリプトのフルパスを
# 環境変数で上書きできます。配布物の標準構造をそのまま使う場合は未設定で構いません。
#
# 【未設定時の既定値】
#   COGNEE_MCP_PYTHON       : <配布物ルート>/src/venv/bin/python3
#   COGNEE_MCP_START_SCRIPT : <配布物ルート>/src/main_src/start_cognee_mcp.py
#
# 【上書きが必要なケース】
# - 配布物外の Python 環境を MCP サーバ起動に使いたい場合
# - 配布物のフォルダ構造をカスタマイズして start_cognee_mcp.py を別の場所に置いた場合
#
# 【設定例】
#   COGNEE_MCP_PYTHON=/home/yourname/custom-venv/bin/python3
#   COGNEE_MCP_START_SCRIPT=/home/yourname/custom-mcp/start_cognee_mcp.py
#
# COGNEE_MCP_PYTHON=
# COGNEE_MCP_START_SCRIPT=


# ============================================================
# cognee 1.0.7/1.0.8 + Ollama 利用時の必須設定
# ============================================================
#
# cognee 1.0.7 で導入された test_llm_connection が Ollama に対して
# /v1 を含まない URL を叩いて 404 になるリグレッションがあります。
# Ollama を LLM プロバイダとして使う場合は以下の設定で回避してください。
# (LLM_ENDPOINT は上記で /v1 を含めて指定済み・本フラグはチェック自体をスキップ)
#
COGNEE_SKIP_CONNECTION_TEST=true
